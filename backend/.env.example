   # ============================================================================                                  
    # SHOPCART - VARIABLES DE ENTORNO DE EJEMPLO                                                                    
    # ============================================================================                                  
                                                                                                                    
    # Servidor                                                                                                      
    PORT=3000                                                                                                       
    NODE_ENV=development                                                                                            
                                                                                                                    
    # Base de Datos (Microsoft SQL Server 2019+)                                                                    
    DB_SERVER=localhost                                                                                             
    DB_PORT=1433                                                                                                    
    DB_USER=sa                                                                                                      
    DB_PASSWORD=TuPasswordSeguro123!                                                                                
    DB_NAME=ShopCartDB                                                                                              
    DB_ENCRYPT=false                                                                                                
    DB_TRUST_SERVER_CERTIFICATE=true                                                                                
                                                                                                                    
    # Autenticación JWT (RF-01)                                                                                     
    # Access Token de corta duración (15 minutos)                                                                   
    JWT_ACCESS_SECRET=clave_secreta_super_segura_access_token_shopcart_2026                                         
    JWT_ACCESS_EXPIRES_IN=15m                                                                                       
                                                                                                                    
    # Refresh Token de larga duración con rotación (7 días)                                                         
    JWT_REFRESH_SECRET=clave_secreta_super_segura_refresh_token_shopcart_2026                                       
    JWT_REFRESH_EXPIRES_IN=7d                                                                                       
                                                                                                                    
    # Seguridad y CORS                                                                                              
    CORS_ORIGIN=http://localhost:5173  